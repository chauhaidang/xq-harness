{
  "name": "xq-fitness-mobile",
  "version": "2.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:check": "expo export --platform ios --output-dir dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "test:integration": "npm run test:integration:local",
    "test:integration:local": "./scripts/run-integration-tests.sh",
    "test:integration:watch": "GATEWAY_URL=http://localhost:8080 jest --config=jest.integration.config.js --watch",
    "test:all": "npm run test:unit",
    "ios:device:doctor": "./device.sh doctor",
    "ios:device:build": "./device.sh build",
    "ios:device:install": "./device.sh install",
    "ios:device:launch": "./device.sh launch",
    "ios:device:verify": "./device.sh verify"
  },
  "dependencies": {
    "@expo/webpack-config": "^19.0.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@types/react": "~18.2.14",
    "axios": "^1.6.2",
    "expo": "~49.0.15",
    "expo-dev-client": "~2.4.13",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.72.10",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@chauhaidang/xq-harness-common-kit": "0.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^24.10.1",
    "expo-build-properties": "0.8.3",
    "jest": "^30.2.0",
    "jest-circus": "^30.2.0",
    "jest-expo": "~49.0.0",
    "jest-junit": "^16.0.0",
    "react-test-renderer": "18.2.0"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "jest-junit": {
    "outputDirectory": "./__tests__/integration/tsr",
    "outputName": "junit.xml",
    "usePathForSuiteName": "true"
  }
}
